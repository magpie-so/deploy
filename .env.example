# ==============================================
# Magpie AI — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Or run setup.sh to auto-generate secrets:
#   ./setup.sh
#
# NEVER commit .env to version control

# ── Licensing ──────────────────────────────────
# Provided during onboarding
MAGPIE_LICENSE_KEY=MGP-XXXX-XXXX-XXXX-XXXX
MAGPIE_LICENSE_SERVER=https://license.magpie.so

# ── Version ───────────────────────────────────
# Docker image version to pull (set by setup.sh, or pin manually)
MAGPIE_VERSION=latest

# ── Ports ──────────────────────────────────────
# Change if conflicts with existing services
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Database ───────────────────────────────────
POSTGRES_DB=magpie
POSTGRES_USER=magpie
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── Redis ──────────────────────────────────────
# Generate: openssl rand -hex 16
REDIS_PASSWORD=

# ── Security ───────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=

# Admin user credentials (created on first startup)
ADMIN_EMAIL=admin@magpie.local
# Generate: openssl rand -base64 16
ADMIN_PASSWORD=

# ── CORS ───────────────────────────────────────
# JSON array — update with your frontend URL/domain
ALLOWED_ORIGINS=["http://localhost"]

# ── LLM ────────────────────────────────────────
# Remote LLM endpoint (RunPod, cloud-hosted vLLM, etc.)
# Leave empty to use the local vLLM container (requires GPU + MAGPIE_LOCAL_LLM=true)
VLLM_URL=
VLLM_MODEL=qwen3-1.7b

# Set to true only if running vLLM locally (GPU required). Leave false for remote LLM.
MAGPIE_LOCAL_LLM=false

# ── Frontend ───────────────────────────────────
# Leave empty if frontend is behind nginx proxy (default)
NEXT_PUBLIC_API_URL=

# ── Application ────────────────────────────────
ENVIRONMENT=production
DEBUG=False
